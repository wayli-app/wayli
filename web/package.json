{
  "name": "web",
  "private": true,
  "version": "2.2.0-rc.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:all": "bun run sync:all && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "bun run test:unit -- --run",
    "test:accessibility": "vitest --run tests/accessibility/",
    "test:accessibility:watch": "vitest tests/accessibility/",
    "test:integration": "vitest --run tests/integration/",
    "test:integration:watch": "vitest tests/integration/",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "sync:functions": "fluxbase functions sync --namespace wayli --dir ../fluxbase/functions/",
    "sync:jobs": "fluxbase jobs sync --namespace wayli --dir ../fluxbase/jobs/",
    "sync:migrations": "fluxbase migrations sync --namespace wayli --dir ../fluxbase/migrations/",
    "sync:chatbots": "fluxbase chatbots sync --namespace wayli --dir ../fluxbase/chatbots/",
    "sync:rpc": "fluxbase rpc sync --namespace wayli --dir ../fluxbase/rpc/",
    "sync:mcp": "fluxbase mcp tool sync --namespace wayli --dir ../fluxbase/mcp-tools/",
    "sync:kb": "fluxbase kb create wayli-pois --namespace wayli --description \"User POI visits with behavioral context for semantic search\" --chunk-size 500 --embedding-model text-embedding-3-small 2>/dev/null || true",
    "sync:kb-tables": "KB_ID=$(fluxbase kb list --namespace wayli -o json 2>/dev/null | jq -r '.[0].id // empty' 2>/dev/null) && [ -n \"$KB_ID\" ] && (fluxbase kb export-table \"$KB_ID\" --schema public --table place_visits --include-fks --sample-rows 3 2>/dev/null || true) && (fluxbase kb export-table \"$KB_ID\" --schema public --table user_preferences --include-fks 2>/dev/null || true) || echo \"KB not found, skipping table export\"",
    "sync:all": "bun run sync:rpc && bun run sync:functions && bun run sync:jobs && bun run sync:chatbots && bun run sync:mcp && bun run sync:migrations && bun run sync:kb && bun run sync:kb-tables",
    "check:separation": "node scripts/check-environment-separation.js"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.19.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "lucide-static": "^1.21.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "semantic-release": "^25.0.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@nimbleflux/fluxbase-sdk": "2026.7.1",
    "@svelte-plugins/datepicker": "^1.0.11",
    "@turf/turf": "^7.3.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.11",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.9.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.5",
    "qrcode": "^1.5.4",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "marked": "^18.0.5"
  }
}
